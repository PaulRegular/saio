\name{saio-package}
\alias{saio-package}
\alias{saio}
\docType{package}
\title{Stock Assessment Inputs and Outputs Database}
\description{
Browse and read published SAIO data releases. SAIO brings together
inputs, assumptions, and outputs from official fish stock assessments.
}
\details{
Start with \code{\link{download_database}()} to get a local copy of a
release. Find a stock with \code{\link{list_stocks}()} and an assessment
with \code{\link{list_assessments}()}. Use \code{\link{read_database}()}
to read the stock or assessment you selected. Record the release tag
with your analysis.
}
